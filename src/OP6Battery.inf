; OP6Battery.inf
; Install INF for OnePlus 6 BLP657 battery miniport driver
; Target Windows 10/11 ARM64 universal driver

[Version]
Signature="$Windows NT$"
Class=Battery
ClassGuid={72631e54-78a4-11d0-bcf7-00aa00b7b32a}
Provider=%ManufacturerName%
CatalogFile=op6battery.cat
PnpLockdown=1
DriverVer=10/20/2026,0.0.0.1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
OP6Battery.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ManufacturerName%=OP6Battery,NTarm64

[OP6Battery.NTarm64]
%OP6Battery.DeviceDesc%=OP6Battery_Install, ACPI\BQ027411

[OP6Battery_Install]
CopyFiles = OP6Battery_CopyFiles
Include = battery.inf
Needs = Battery_Inst

[OP6Battery_CopyFiles]
OP6Battery.sys

[OP6Battery_Install.Services]
AddService = OP6Battery, 0x00000002, OP6Battery_Service

; KMDF-драйвер без этой секции не биндится к фреймворку
[OP6Battery_Install.Wdf]
KmdfService = OP6Battery, OP6Battery_wdfsect

[OP6Battery_wdfsect]
KmdfLibraryVersion = 1.33

[OP6Battery_Service]
DisplayName    = %OP6Battery.ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\OP6Battery.sys
LoadOrderGroup = Extended Base

[Strings]
ManufacturerName        = "OnePlus"
DiskName                = "OP6Battery Installation Media"
OP6Battery.DeviceDesc   = "OnePlus 6 Battery"
OP6Battery.ServiceDesc  = "OnePlus 6 Battery Driver"
