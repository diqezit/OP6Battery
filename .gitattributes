# Normalize all text files to LF in repo
* text=auto

# Windows sources and build files
*.c                text eol=crlf
*.h                text eol=crlf
*.rc               text eol=crlf
*.def              text eol=crlf
*.inf              text eol=crlf
*.bat              text eol=crlf
*.cmd              text eol=crlf
*.ps1              text eol=crlf
*.psm1             text eol=crlf
*.psd1             text eol=crlf
*.sln              text eol=crlf
*.vcxproj          text eol=crlf
*.vcxproj.user     text eol=crlf
*.filters          text eol=crlf
*.props            text eol=crlf
*.targets          text eol=crlf

# Unix-style text
*.md               text eol=lf
*.yml              text eol=lf
*.yaml             text eol=lf
*.json             text eol=lf
*.gitignore        text eol=lf
LICENSE            text eol=lf
LICENSE.txt        text eol=lf

# Binary artifacts - never touch
*.sys              binary
*.pdb              binary
*.cer              binary
*.pfx              binary
*.pvk              binary
*.cat              binary
*.lib              binary
*.obj              binary
*.exe              binary
*.dll              binary